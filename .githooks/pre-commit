#!/usr/bin/env bash
# =====================================================================
# Pre-commit hook.
#
# Install once per clone:
#   git config core.hooksPath .githooks
#
# Blocks four things that are painful to undo once pushed:
#   1. A real credential — a service_role JWT, a secret key, or a
#      connection string with an actual password in it
#   2. shared/ edited without running sync.sh, so the apps silently drift
#   3. A committed config.js — it differs per division and is generated
#   4. A CDN import sneaking back into shipped app code
#
# DESIGN NOTE — why this does not grep for the word "service_role".
#
# An earlier version did, and it blocked five files on the first commit:
# a placeholder password in .env.example, the word appearing in two
# documents, "create role service_role" in the test shim (a legitimate
# PostgreSQL role name), and an error message in a script that tells the
# user not to paste that key. None of those was a leak.
#
# A guard that cries wolf gets bypassed with --no-verify, and then it is
# protecting nothing. So this version looks for the SHAPE of a credential
# instead of the word: a JWT whose payload claims the service_role, a
# secret key with Supabase's sb_secret_ prefix, or a connection string
# whose password is not obviously a placeholder.
# =====================================================================
set -uo pipefail

STAGED=$(git diff --cached --name-only --diff-filter=ACM)
[ -z "$STAGED" ] && exit 0

FAIL=0
say() { printf '\n  %s\n' "$*"; }

# Is this password field a placeholder rather than a real secret?
is_placeholder() {
  case "$1" in
    *'<'*|*'>'*|*'{'*|*'['*|\$*|*'PASSWORD'*|*'password'*|*'YOUR_'*|*'xxx'*|*'XXX'*|\
    *'CHANGEME'*|*'changeme'*|*'REPLACE'*|*'example'*|*'EXAMPLE'*) return 0 ;;
  esac
  # Short values are almost certainly examples, not generated passwords.
  [ ${#1} -lt 12 ] && return 0
  return 1
}

# ------------------------------------------------------- 1. real credentials
for f in $STAGED; do
  [ -f "$f" ] || continue
  case "$f" in
    *.png|*.jpg|*.jpeg|*.pdf|*.zip|*.woff2|*/vendor/*) continue ;;
    .githooks/*) continue ;;
  esac

  BODY=$(cat "$f")

  # (a) A JWT whose payload claims service_role. The anon key and the
  #     service_role key are both JWTs and look identical from outside, so
  #     the payload is the only reliable discriminator. This catches a
  #     pasted key with no giveaway text around it.
  for TOKEN in $(printf '%s' "$BODY" | grep -oE 'eyJ[A-Za-z0-9_-]{10,}\.eyJ[A-Za-z0-9_-]{10,}' || true); do
    B64=$(printf '%s' "$TOKEN" | cut -d. -f2 | tr '_-' '/+')
    case $(( ${#B64} % 4 )) in 2) B64="$B64==" ;; 3) B64="$B64=" ;; esac
    if printf '%s' "$B64" | base64 -d 2>/dev/null | grep -q 'service_role'; then
      say "BLOCKED  $f contains a SERVICE_ROLE JWT."
      say "         Rotate it in Supabase now — assume it is burned."
      FAIL=1
    fi
  done

  # (b) Supabase's newer secret key format. Unambiguous by prefix.
  if printf '%s' "$BODY" | grep -qE 'sb_secret_[A-Za-z0-9_-]{8,}'; then
    say "BLOCKED  $f contains a Supabase SECRET key (sb_secret_…). Rotate it now."
    FAIL=1
  fi

  # (c) A connection string carrying a real password.
  for URI in $(printf '%s' "$BODY" | grep -oE 'postgres(ql)?://[^[:space:]"'"'"'`]+' || true); do
    CRED=${URI#*://}
    case "$CRED" in *@*) ;; *) continue ;; esac
    PW=${CRED%%@*}; PW=${PW#*:}
    [ -z "$PW" ] && continue
    if ! is_placeholder "$PW"; then
      say "BLOCKED  $f contains a database connection string with a real password."
      say "         Replace it with <password> and keep the real one in the vault."
      FAIL=1
    fi
  done
done

# ------------------------------------------------- 2. shared/ out of step
if printf '%s\n' $STAGED | grep -q '^shared/'; then
  for pair in "tokens.css:apps/inspect/tokens.css" \
              "inspect.css:apps/inspect/styles.css" \
              "supabase.js:apps/inspect/supabase.js" \
              "logo.js:apps/inspect/logo.js" \
              "changelog.js:apps/inspect/changelog.js" \
              "vendor-supabase.js:apps/inspect/vendor/supabase.js"; do
    SRC="shared/${pair%%:*}"; DEST="${pair##*:}"
    if [ -f "$SRC" ] && ! cmp -s "$SRC" "$DEST"; then
      say "BLOCKED  $SRC differs from $DEST. Run ./shared/sync.sh and stage the result."
      FAIL=1
    fi
  done
fi

# --------------------------------------------------- 3. committed config
if printf '%s\n' $STAGED | grep -qE '^apps/[^/]+/config\.js$'; then
  say "BLOCKED  config.js must not be committed — it differs per division and is"
  say "         generated by scripts/gen-config.mjs at deploy time."
  FAIL=1
fi

# ------------------------------------------------ 4. version and changelog
# A change to the app, the shared assets or the schema has to arrive with a
# release note and a version bump. This is not bookkeeping: the change history
# of a quality system is something a certification body asks to see, and
# reconstructing it from a git log months later is not the same thing.
WATCHED=$(printf '%s\n' $STAGED | grep -E '^(apps/|shared/|db/)' \
          | grep -v '/config\.js$' | grep -v '/_headers$' \
          | grep -v 'schema-complete\.sql$' | grep -v 'changelog\.js$' || true)
if [ -n "$WATCHED" ]; then
  if ! printf '%s\n' $STAGED | grep -q 'changelog\.js$'; then
    say "BLOCKED  these changed without a release note:"
    printf '%s\n' "$WATCHED" | head -6 | sed 's/^/           /'
    say "         Bump APP_VERSION and add an entry in shared/changelog.js,"
    say "         then run ./shared/sync.sh."
    FAIL=1
  else
    # The note must belong to the new version, not repeat the last one.
    NEWV=$(grep -oE 'APP_VERSION = "[0-9]+\.[0-9]+\.[0-9]+"' shared/changelog.js | head -1 |
           grep -oE '[0-9]+\.[0-9]+\.[0-9]+')
    TOPV=$(grep -oE 'v: "[0-9]+\.[0-9]+\.[0-9]+"' shared/changelog.js | head -1 |
           grep -oE '[0-9]+\.[0-9]+\.[0-9]+')
    if [ "$NEWV" != "$TOPV" ]; then
      say "BLOCKED  APP_VERSION is $NEWV but the newest changelog entry is $TOPV."
      FAIL=1
    fi
    OLDV=$(git show HEAD:shared/changelog.js 2>/dev/null |
           grep -oE 'APP_VERSION = "[0-9]+\.[0-9]+\.[0-9]+"' | head -1 |
           grep -oE '[0-9]+\.[0-9]+\.[0-9]+' || true)
    if [ -n "$OLDV" ] && [ "$OLDV" = "$NEWV" ]; then
      say "BLOCKED  APP_VERSION is still $NEWV. Bump it — patch for a fix,"
      say "         minor for anything a user would notice."
      FAIL=1
    fi
  fi
fi

# -------------------------------------------------------- 5. CDN imports
for f in $STAGED; do
  case "$f" in apps/*|shared/*) ;; *) continue ;; esac
  case "$f" in */vendor/*) continue ;; esac
  [ -f "$f" ] || continue
  if grep -qE '(src|from|import)[^\n]*(esm\.sh|unpkg\.com|cdn\.jsdelivr|skypack)' "$f"; then
    say "BLOCKED  $f loads code from a CDN. The client is vendored so the CSP can"
    say "         stay script-src 'self'. Put the dependency in shared/ instead."
    FAIL=1
  fi
done

if [ $FAIL -ne 0 ]; then
  say "Commit aborted. If you are certain a finding is wrong, fix the hook rather"
  say "than reaching for --no-verify: a guard that gets bypassed protects nothing."
fi
exit $FAIL
