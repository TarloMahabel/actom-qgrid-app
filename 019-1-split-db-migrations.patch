 import { readFileSync, writeFileSync, readdirSync } from "node:fs";
 
 const OUT = "db/schema-complete.sql";
-const migrations = readdirSync("db").filter(f => /^\d{3}-.*\.sql$/.test(f)).sort();
-if (!migrations.length) { console.error("No migrations found in db/"); process.exit(1); }
+const DIR = "db/migrations";
+const migrations = readdirSync(DIR).filter(f => /^\d{3}-.*\.sql$/.test(f)).sort();
+if (!migrations.length) { console.error(`No migrations found in ${DIR}/`); process.exit(1); }
+
+/* Two files claiming the same number is not something to resolve by sorting.
+   db/ held this product's migrations and the apprenticeship portal's in one
+   flat directory, and the glob above swept up both — so schema-complete.sql,
+   the script a new division is provisioned from, carried the other product's
+   schema and stamped it into this product's ledger. The directory fixes that
+   once; this guard is what stops it happening again. */
+const dupes = migrations.filter((f, i, a) => i && f.slice(0, 3) === a[i - 1].slice(0, 3));
+if (dupes.length) {
+  console.error(`Two migrations share a number: ${dupes.join(", ")}`);
+  process.exit(1);
+}
 
