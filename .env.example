# Local development and the migration scripts. Copy to .env for reference,
# but note that nothing reads a .env file automatically — these are set in
# the shell (see WINDOWS.md for PowerShell syntax).
#
# Production values live in Netlify site environment variables and GitHub
# Actions secrets, never here.

# --- Netlify site variables (per division) -----------------------------
# The build turns these into apps/inspect/config.js and _headers.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...
DIVISION_CODE=MVS
DIVISION_NAME=ACTOM MV Switchgear

# --- Migration runner (CI and local admin only) ------------------------
# One per division, named DB_URL_<CODE>. Service-role connection strings:
# never in Netlify, never committed. The pre-commit hook blocks them.
DB_URL_MVS=postgresql://postgres:<password>@db.xxxxxxxxxxxx.supabase.co:5432/postgres

# --- Provisioning a new division (scripts/new-division.mjs) ------------
GITHUB_REPO=TarloMahabel/actom-qgrid-app
SUPABASE_ACCESS_TOKEN=
SUPABASE_ORG_ID=
NETLIFY_AUTH_TOKEN=
DB_PASSWORD_NEW=
